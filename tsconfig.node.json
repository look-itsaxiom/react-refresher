{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node", "vite/client"]
  },
  "include": ["vite.config.ts", "vite-plugin-progress.ts", "vite-plugin-progress.test.ts", "vite-plugin-local-check.ts", "vite-plugin-local-check.test.ts", "src/content/__tests__/local-exercises.test.ts"]
}
